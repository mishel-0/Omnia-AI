# Omnia Pathology AI — Environment Configuration
# Copy this to .env.local and adjust values. Everything below has a safe default;
# nothing here needs to be set for local development.

# Backend API URL (frontend connects here)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js DevTools (disable for production)
NEXT_DEVTOOLS_DISABLED=1

# JWT secret (auto-generated on first run if empty)
# OMNIA_JWT_SECRET=

# Where trial/patient/audit data is stored (defaults to ./data)
# OMNIA_DATA_DIR=
