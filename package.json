{
  "name": "omnia-ai",
  "version": "1.18.0",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "check-all": "npm run lint & npm run type-check & wait",
    "test": "python3 tests/integration_api_test.py",
    "check:env": "python3 scripts/check_env.py",
    "check:api": "python3 scripts/check_api.py",
    "check:deps": "python3 scripts/audit_deps.py",
    "check:all": "bash scripts/run_all.sh",
    "desktop:dev": "electron desktop/main.js",
    "desktop:build": "bash scripts/build-desktop.sh",
    "desktop:build:mac": "bash scripts/build-desktop.sh mac",
    "desktop:build:win": "bash scripts/build-desktop.sh win",
    "desktop:package": "electron-builder"
  },
  "build": {
    "appId": "com.omnia.pathology.ai",
    "productName": "Omnia Pathology AI",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "frontend"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/icon.icns",
      "category": "public.app-category.medical",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "dist/omnia-backend",
          "to": "backend"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico",
      "extraResources": [
        {
          "from": "dist/omnia-backend",
          "to": "backend"
        }
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "publisherName": "Omnia Pathology AI"
      }
    },
    "dmg": {
      "icon": "desktop/icon.icns",
      "background": "build/dmg-background.png",
      "title": "Omnia Pathology AI ${version}",
      "iconSize": 96,
      "iconTextSize": 12,
      "window": {
        "width": 640,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 250,
          "type": "file"
        },
        {
          "x": 460,
          "y": 250,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.txt",
      "installerIcon": "desktop/icon.ico"
    },
    "electronDownload": {
      "mirror": "https://github.com/electron/electron/releases/download/"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "15.5.7",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.12.0",
    "postcss": "^8",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@oxlint/binding-darwin-arm64": "^1.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "description": "Offline AI pathology suite for prostate biopsy grading in clinical trials.",
  "author": "Omnia Pathology AI"
}
